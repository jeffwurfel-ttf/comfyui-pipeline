# Environment
.env

# Output files
output/*
!output/.gitkeep

# Input files
input/*
!input/.gitkeep

# Model backups (large files)
*.tar.gz
models_backup_*.tar.gz

# Installed models JSON (generated)
models/installed_models.json

# Agent workspace — local operating layer, not a shipped deliverable
CLAUDE.md
.dev/
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Build artifacts
build.log
*.log

# Local backups (git history is the real backup)
Dockerfile.before_*
*.bak

# Local archive of retired scripts
archive/

# Hardening pass backups (May 2026)
*.pre_hardening

# ---------------------------------------------------------------------------
# Vendored custom_node model weights.
#
# The node packs under custom_nodes/ are vendored source (see
# .dev/VENDORED_NODES.md). The binary model weights that ship INSIDE those
# upstream repos are deliberately NOT committed — the pinned clone in the
# Dockerfile is what puts them in the image, so git carrying them buys nothing
# and costs ~30 MB of undiffable blobs.
#
# Every path below is recorded in .dev/VENDORED_NODES.md with size, sha256,
# upstream repo, pinned commit and the upstream git blob hash. Do not add a
# weight here without adding it there.
# ---------------------------------------------------------------------------
custom_nodes/ComfyUI-KJNodes/intrinsic_loras/*.safetensors
custom_nodes/ComfyUI-WanVideoWrapper/configs/T5_tokenizer/spiece.model
custom_nodes/ComfyUI-WanVideoWrapper/fantasyportrait/models/*.onnx
custom_nodes/ComfyUI-WanVideoWrapper/multitalk/encoded_silence.safetensors

# Build output that must never be vendored: the sam3dobjects / SeedVR2
# subprocess venvs are rebuilt by the Dockerfile (sam3dobjects/_env alone is
# 6.9 GB inside the container).
custom_nodes/*/_env/

# Re-include vendored upstream content that generic rules above would drop.
# `*.bak` (line ~43) exists for host-side Dockerfile.before_* backups. Three
# .bak files ship INSIDE the sam3dobjects 0.0.11 zip (they carry the zip's own
# mtime, 2025-12-09) and are upstream source, not local edits.
!custom_nodes/**/*.bak

# Operating layer — never committed
.dev/
.claude/
CLAUDE.md

# WanVideoWrapper: tokenizer vocab artifacts and example media.
# Same reasoning as the weights above — the pinned clone puts them in the
# image; git carrying 28 MB of undiffable JSON vocab buys nothing.
custom_nodes/ComfyUI-WanVideoWrapper/configs/T5_tokenizer/tokenizer.json
custom_nodes/ComfyUI-WanVideoWrapper/qwen/tokenizer/tokenizer.json
custom_nodes/ComfyUI-WanVideoWrapper/qwen/tokenizer/vocab.json
custom_nodes/ComfyUI-WanVideoWrapper/qwen/tokenizer/merges.txt
custom_nodes/ComfyUI-WanVideoWrapper/example_workflows/example_inputs/
